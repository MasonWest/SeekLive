# ============================================================
#  SeekLive · 版本库忽略规则
#  原则：仓库里只放「代码 + 文档 + 示例配置」，
#        运行期数据、缓存、日志、私人路径、管理口令一律不进。
# ============================================================

# ---------- 运行期数据（含索引 / 缓存 / 回收站 / 日志）----------
# data/          索引库 index.db、缓存清单 cache.db、回收站账本 trash.db 与 data/trash/ 里的真实文件
# cache/         缩略图 / 大图 / 转码产物 / 视频抽帧
# logs/          访问日志与调试日志（含本机路径）
# tmp/           测试用的临时工作树、测试产物、运行输出
data/
cache/
logs/
tmp/

# 服务自身的运行时标记
*.pid
*.port

# ---------- Python ----------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ---------- 本机私有配置 ----------
# libraries.json 里有本机绝对路径与私有目录名
# admin.json     里有管理口令
# 两份都要用 *.example.json 作模板（模板可以提交）
libraries.json
admin.json

# ---------- 本地凭据 / 密钥 ----------
# 文本形式的 token / PAT / 私钥，一律只留在本机，绝不进版本库。
# 例：github密钥.txt
github密钥.txt
*密钥*.txt
*.pem
*.key

# ---------- 助手工具的本机状态 ----------
# .workbuddy/ 里是本地工作记录（含本机路径与个人项目笔记），不进版本库。
# 如需把项目笔记纳入版本管理，删掉下面这行即可。
.workbuddy/

# 运行期数据库（即便目录规则被改动也兜底）
*.db
*.db-wal
*.db-shm
*.cache
*.b64

# ---------- 媒体素材（仓库不携带任何照片 / 视频）----------
*.jpg
*.jpeg
*.png
*.gif
*.webp
*.bmp
*.heic
*.heif
*.mov
*.mp4
*.mkv
*.avi
*.log

# ---------- 依赖 ----------
node_modules/

# ---------- 外部二进制（本机依赖，不是代码）----------
# ffmpeg 体积近 100MB（超出 GitHub 单文件 100MB 上限），且各平台不通用：
# 放项目根目录即可被 detect_ffmpeg() 自动探测，或设环境变量 FFMPEG_BIN 指定路径。
ffmpeg
ffmpeg.exe
ffprobe
ffprobe.exe

# ---------- 照片时间推算脚本的产物 ----------
# tools/photo_time_repair.py 生成的明细表 / 覆盖表里含本机照片绝对与相对路径
# （含私有目录名），与本项目的「仓库不带私人路径」原则冲突，一律不进版本库。
tools/out/

# ---------- 测试生成物 ----------
tests/e2e/shots/
tests/**/result*.txt
tests/**/_admin_srv_*.out
*.out

# ---------- 编辑器 / 系统 ----------
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
